#!/usr/bin/env bash
# Builds Rhein for production and publishes it as a GitHub release of this repository:
#
#   ./rheinrelease v0.1.0-test1             build, pack, publish as a pre-release
#   ./rheinrelease v0.1.0 --stable          the same, as a normal release
#   ./rheinrelease v0.1.0-test1 --no-upload build and pack only (the archive stays in dist/)
#
# The archive, rhein-<version>-linux-x86_64.tar.gz, holds the binary, the desktop entry, the icon
# and install.sh, which puts them under ~/.local (or /usr with sudo). The binary needs the system
# libraries a Rhein build needs at run time (ALSA, Vulkan, xkbcommon, GLib, PipeWire and the
# desktop portal for screen sharing), and a glibc at least as new as the one it was built on.
# Needs the GitHub CLI (`gh`), signed in.
set -euo pipefail
root="$(cd "$(dirname "$0")" && pwd)"
cd "$root"

version="" prerelease=1 upload=1
for arg in "$@"; do
  case "$arg" in
    --stable) prerelease=0 ;;
    --no-upload) upload=0 ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown option: $arg (see --help)" >&2; exit 2 ;;
    *) version="$arg" ;;
  esac
done
[[ -n $version ]] || { echo "which version? e.g. ./rheinrelease v0.1.0-test1" >&2; exit 2; }
if ((upload)); then
  command -v gh >/dev/null || { echo "the GitHub CLI (gh) is not installed" >&2; exit 1; }
  gh auth status >/dev/null 2>&1 || { echo "gh is not signed in: gh auth login" >&2; exit 1; }
  [[ -z $(git status --porcelain) ]] || { echo "the working tree has uncommitted changes; commit them first" >&2; exit 1; }
fi

./rheinprod --build-only --no-deps

name="rhein-$version-linux-x86_64"
stage="dist/$name"
rm -rf "$stage" && mkdir -p "$stage"
install -m755 target/production/rhein "$stage/rhein"
install -m644 packaging/chat.rhein.Rhein.desktop packaging/chat.rhein.Rhein.png "$stage/"
cat > "$stage/install.sh" <<'INSTALL'
#!/usr/bin/env bash
# Installs Rhein for this user (~/.local), or for everyone with --system (/usr, needs sudo).
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
prefix="$HOME/.local" run=()
[[ ${1:-} == --system ]] && prefix=/usr run=(sudo)
"${run[@]}" install -Dm755 "$here/rhein" "$prefix/bin/rhein"
"${run[@]}" install -Dm644 "$here/chat.rhein.Rhein.desktop" "$prefix/share/applications/chat.rhein.Rhein.desktop"
"${run[@]}" install -Dm644 "$here/chat.rhein.Rhein.png" "$prefix/share/icons/hicolor/512x512/apps/chat.rhein.Rhein.png"
command -v update-desktop-database >/dev/null && "${run[@]}" update-desktop-database -q "$prefix/share/applications" || true
echo "installed into $prefix; start it with: rhein"
case ":$PATH:" in *":$prefix/bin:"*) ;; *) echo "note: $prefix/bin is not on your PATH" ;; esac
INSTALL
chmod +x "$stage/install.sh"
tar -czf "dist/$name.tar.gz" -C dist "$name"
( cd dist && sha256sum "$name.tar.gz" > "$name.tar.gz.sha256" )
echo "· packed dist/$name.tar.gz ($(du -h "dist/$name.tar.gz" | cut -f1))"

if ((!upload)); then
  exit 0
fi
notes="Test build of Rhein, the native Telium client, for Linux x86_64.

Unpack, then run \`./install.sh\` (for you, into ~/.local) or \`./install.sh --system\` (for everyone, into /usr).

Needs ALSA, Vulkan, xkbcommon, GLib, PipeWire and xdg-desktop-portal with your desktop's backend for screen sharing. Built on a current Arch-based system: older distributions may lack the glibc it needs; build from source there with \`./rheinprod\`."
flags=(--title "Rhein $version" --notes "$notes" --target "$(git rev-parse HEAD)")
((prerelease)) && flags+=(--prerelease)
gh release create "$version" "dist/$name.tar.gz" "dist/$name.tar.gz.sha256" "${flags[@]}"
